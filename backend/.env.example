# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# You can use a local MongoDB instance, MongoDB Atlas, or leave it blank to auto-fallback to embedded in-memory MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/student_exam_db
USE_MEMORY_DB=auto

# Security & Authentication
JWT_SECRET=super_secure_exam_platform_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# WhatsApp Business / Cloud API Configuration
# Recipient to be notified automatically when a student fails an exam:
WHATSAPP_RECIPIENT=+91 6305497264

# Meta / WhatsApp Cloud API credentials
# Obtain these from developers.facebook.com -> WhatsApp -> API Setup
# If left empty, notifications are safely logged as NOT_CONFIGURED without crashing.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
